# GitHub API Token for fetching releases and contributors
IDLERECORD_API_RELEASE_TOKEN=your_github_token_here
CONTRIBUTORS_PAT=your_github_token_here

# Next.js Configuration
NEXT_PUBLIC_LIBNAME=IMQA SDK
MDX=docs

# Optional: GitHub API Base URL (for enterprise)
GITHUB_API_URL=https://api.github.com

# Vercel specific
VERCEL_URL=your-vercel-url.vercel.app

# Cache revalidation secret (for API endpoints)
REVALIDATE_SECRET=your_random_secret_here

# Optional: Node environment
NODE_ENV=production
